<?xml version="1.0" encoding="utf-8"?><!-- -*- coding: utf-8; mode: SGML -*- -->
<Anura3D_data version="3.0">
  <style show_menubutton_about="0" show_menubutton_search="1"/>
  <!-- units -->
  <units>
    <!--by now it is compulsory define this node if units are used (could be empty if defaults are enougth)-->
  </units>
  <!-- ############ Container of units ############ -->
  <container n="General_data" pn="General data" icon="ruler" help="Setup unit system, problem dimensions, and gravity acceleration." tree_state="close">
    <container n="units" pn="Units" icon="size" help="Common to all models" tree_state="close">
      <value n="units_mesh" pn="Geometry unit" values="m" v="m" editable="0"/>
      <value n="units_force" pn="Force unit" values="kN" v="kN" editable="0"/>
      <value n="units_time" pn="Time unit" values="s" v="s" editable="0"/>
    </container>
    <container n="GRAVITY_DATA" pn="Gravity data" icon="gravity.png" tree_state="close">
      <value n="gravity_acceleration" pn="gravity acceleration [m/s2]" v="9.81"/>
      <value n="gravity_vector_x" pn="gravity vector x [-]" v="0.0"/>
      <value n="gravity_vector_y" pn="gravity vector y [-]" v="-1.0"/>
      <value n="gravity_vector_z" pn="gravity vector z [-]" v="0.0"/>
    </container>
    <value n="NDIM" pn="Problem dimensions" icon="" help="Setup problem dimensions" values="2D:plane-strain,2D:Axissymmetric,3D,3D:Axissymmetric" v="2D:plane-strain" actualize_tree="1" tree_state="close"/>
    <value n="NLAYERS" pn="MPM discretization type" icon="" help="Select the number of layers for multiphase simulations. Only for MPM solvers." values="Single_point,Double_point" v="Single_point" actualize_tree="1" tree_state="close"/>
    <container n="POSTPROCESS_VISUALIZATION_SOFTWARE" pn="Post-processing visualization software" icon="post.png" tree_state="close">
      <value n="Paraview" pn="ParaView" v="1" values="1,0" state="normal" actualize_tree="1"/>
      <value n="GiD_ASCII" pn="GiD (ASCII format)" v="1" values="1,0" state="normal" actualize_tree="1"/>
      <value n="GiD_Binary" pn="GiD (Binary format)" v="1" values="1,0" state="normal" actualize_tree="1"/>
    </container>
  </container>
  <!-- ############ Stages ############ -->
  <container n="stages" pn="Stages" icon="stage16" help="List of calculation stages.\nInitial stage is indicated as Stage 0." tree_state="open">
    <blockdata n="stage" pn="stage" name="Stage 0" sequence="1" generalinfo="mark_calculate,1,calculation_state,OKcalc,prevcalcstate,shouldnotcalc,total_time,   2.49999999999966     ,number_of_active_elements,          15,cps_extension_after_calc,CPS_051,out_num_material_points,           3,out_material_points,{           1} {          25} {          58},prev_stage_steps,50" sequence_type="non_void_deactivated" active="1" editable_name="unique" icon="stage16" before_update_proc="" update_proc="" open_window="0" help="Adds a new calculation stage to the sequential stages list.\nEach calculation stage corresponds to a particular construction stage." tree_state="open">
      <value n="update_materials" pn="Update Materials" icon="icon_material" values="do not apply,apply" v="do not apply" state="[activate_not_initial_stage %W]"/>
      <container n="materials" pn="Materials" icon="icon_material" tree_state="close">
        <blockdata n="material" name="soil" sequence="1" editable_name="unique" morebutton="0" icon="icon_material" tree_state="open">
          <container n="_basic" pn="BASIC PROPERTIES" tree_state="open">
            <value n="material_type_" pn="Material type" v="Saturated material-fully coupled" values="Dry material,Saturated material-drained,Saturated material-undrained effective stress,Saturated material-undrained total stress,Saturated material-fully coupled,Unsaturated material-2-phase with suction effect,Unsaturated material-3-phase fully coupled,Liquid" actualize_tree="1" tree_state="close"/>
            <value n="initial_porosity_" pn="initial porosity" v="0.4" state="[hide_show_y_n_liq_n %W]" tree_state="close"/>
            <value n="density_solid_" pn="density solid" v="2650" state="[hide_show_y_n_liq_n %W]" tree_state="close"/>
            <value n="density_liquid_" pn="density liquid" v="1000" state="[hide_show_y_n_dry %W]" tree_state="close"/>
            <value n="K0-value_" pn="K0-value" v="0.0" state="[hide_show_y_n_liq_n %W]" tree_state="close"/>
            <value n="intrinsic_permeability_liquid_" pn="intrinsic permeability liquid" v="1.0214e-9" state="[hide_show_y_n_intr_perm %W]" tree_state="close"/>
            <value n="bulk__modulus_liquid_" pn="bulk modulus liquid" v="2.15e4" state="[hide_show_y_n_sat_ful %W]" tree_state="close"/>
            <value n="dinamic_viscosity_liquid_" pn="liquid dinamic viscosity" v="1.002e-6" state="[hide_show_y_n_sat_ful %W]" tree_state="close"/>
            <value n="liquid_cavitation_" pn="liquid cavitation" v="0.0" state="[hide_show_y_n_liq_y %W]"/>
            <value n="detect_free_surface_liquid_" pn="detect free surface" v="No" values="No,Yes" help="No= no free surface detection, Yes= free surface detection" actualize_tree="1" state="[hide_show_y_n_liq_y %W]"/>
            <value n="free_surface_factor_" pn="free surface factor" help="Free surface factor" v="0.0" state="[free_surf_fact %W]"/>
            <value n="density_gas_" pn="density gas" v="0.0" state="[hide_show_y_n_un_3 %W]"/>
            <value n="intrinsic_permeability_gas_" pn="intrinsic permeability gas" v="0.0" state="[hide_show_y_n_un_3 %W]"/>
            <value n="bulk__modulus_gas_" pn="bulk modulus gas" v="0.0" state="[hide_show_y_n_un_3 %W]"/>
            <value n="dinamic_viscosity_gas_" pn="gas dinamic viscosity" v="0.0" state="[hide_show_y_n_un_3 %W]"/>
            <value n="elastic_swelling_index_" pn="elastic swelling index" v="0.0" state="[hide_show_y_n_un_3 %W]"/>
          </container>
          <container n="_material_constitutive_model" pn="MATERIAL CONSTITUTIVE MODEL" state="[hide_show_const_model_mat_type_n Liquid %W]" tree_state="open">
            <value n="_material_model_solid_" pn="Solid material model" values="Rigid body,Linear Elasticity,Mohr-Coulomb,External Material Model" v="Linear Elasticity" state="[hide_show_const_model_mat_type_n Liquid %W]" actualize_tree="1" tree_state="close"/>
            <value n="material_model_dll_" pn="Name of the external material model" v="" state="[hide_show_const_model {External Material Model} %W]"/>
            <value n="material_model_dll_dim_" pn="Size of stress tensor" values="2D,3D" v="3D" state="[hide_show_const_model {External Material Model} %W]"/>
            <value n="x-constr" pn="Constraint x-displacement" values="No,Yes" v="No" help="Must be used with contact algorithm" state="[hide_show_const_model {Rigid body} %W]" tree_state="close"/>
            <value n="y-constr" pn="Constraint y-displacement" values="No,Yes" v="No" help="Must be used with contact algorithm" state="[hide_show_const_model {Rigid body} %W]" tree_state="close"/>
            <value n="z-constr" pn="Constraint z-displacement" values="No,Yes" v="No" help="Must be used with contact algorithm" state="[hide_show_const_model_z {Rigid body} %W]"/>
            <value n="eff_poisson_ratio_" pn="Effective Poisson ratio" v="0.3" state="[hide_show_const_model_multi {Linear Elasticity} {Mohr-Coulomb} %W]" tree_state="close"/>
            <value n="undr_poisson_ratio_" pn="Undrained Poisson ratio" v="0.0" state="[hide_show_const_model_multi_undr {Linear Elasticity} {Mohr-Coulomb} %W]"/>
            <value n="eff_Young_modulus_" pn="Effective Young modulus" v="1000" state="[hide_show_const_model_multi {Linear Elasticity} {Mohr-Coulomb} %W]" tree_state="close"/>
            <value n="eff_cohesion_" pn="Effective Cohesion" v="0.0" state="[hide_show_const_model {Mohr-Coulomb} %W]"/>
            <value n="eff_friction_angle_" pn="Effective Friction Angle" v="0.0" state="[hide_show_const_model {Mohr-Coulomb} %W]"/>
            <value n="eff_dilatancy_angle_" pn="Effective Dilatancy Angle" v="0.0" state="[hide_show_const_model {Mohr-Coulomb} %W]"/>
            <value n="eff_tensile_strength_" pn="Effective Tensile Strength" v="0.0" state="[hide_show_const_model {Mohr-Coulomb} %W]"/>
            <container n="mat_params" pn="Define material parameters and state variables" state="[hide_show_const_model {External Material Model} %W]" help="Define material parameters and state variables">
              <value n="number_mat_params" pn="Number of material parameters" string_is="integer" v="50" help="Enter the number of material parameters"/>
              <value n="number_state_var" pn="Number of state variables" string_is="integer" v="50" help="Enter the number of state variables"/>
              <edit_command n="edit_number_mat_params" pn="Material parameters and state variables" proc="MaterialParameters::mat_params_window %W" edit_type="exclusive"/>
            </container>
            <value n="_material_model_liquid_" pn="Liquid material model" v="" values="Newtonian,Bingham Fluid,Frictional Fluid" help="No= no free surface detection, Yes= free surface detection" actualize_tree="1" state="[hide_show_const_model_mat_type_y Liquid %W]"/>
            <value n="elastic_young_modulus_l_" pn="Elastic Young modulus" v="0.0" state="[hide_show_const_model_multi_liq {Bingham Fluid} {Frictional Fluid} %W]"/>
            <value n="elastic_poisson_ratio_l_" pn="Elastic Poisson ratio" v="0.0" state="[hide_show_const_model_multi_liq {Bingham Fluid} {Frictional Fluid} %W]"/>
            <value n="bingham_yield_stress_" pn="Bingham yield stress" v="0.0" state="[hide_show_const_model_liq {Bingham Fluid} %W]"/>
            <value n="fluid_friction_angle_" pn="Fluid friction angle" v="0.0" state="[hide_show_const_model_liq {Frictional Fluid} %W]"/>
            <value n="_unsat_retention_curve_" pn="Liquid Retention curve" v="" values="Linear,Van Genuchten" actualize_tree="1" state="[is_unsat %W]"/>
            <value n="_unsat_rc_linear" pn="Linear coefficient" v="0.0" state="[is_unsat_ret {Linear} %W]"/>
            <value n="slrc_min_deg_sat_" pn="Minumin degree of saturation" v="0.0" state="[is_unsat_ret {Van Genuchten} %W]"/>
            <value n="slrc_max_deg_sat_" pn="Maximum degree of saturation" v="0.0" state="[is_unsat_ret {Van Genuchten} %W]"/>
            <value n="slrc_ref_press_" pn="Reference pressure" v="0.0" state="[is_unsat_ret {Van Genuchten} %W]"/>
            <value n="slrc_lambda_" pn="Lambda" v="0.0" state="[is_unsat_ret {Van Genuchten} %W]"/>
            <value n="_unsat_hydraulic_cond_" pn="Hydarulic conductivity curve" v="" values="Constant,Hillel,Mualem" state="[is_unsat %W]"/>
            <value n="hycon_r_exp" pn="r exponent" v="0.0" state="[is_unsat_cond {Hillel} %W]"/>
            <value n="hycon_min_deg_sat_" pn="Minumin degree of saturation" v="0.0" state="[is_unsat_cond {Mualem} %W]"/>
            <value n="hycon_max_deg_sat_" pn="Maximum degree of saturation" v="0.0" state="[is_unsat_cond {Mualem} %W]"/>
            <value n="hycon_ref_press_" pn="Reference pressure" v="0.0" state="[is_unsat_cond {Mualem} %W]"/>
            <value n="hycon_lambda_" pn="Lambda" v="0.0" state="[is_unsat_cond {Mualem} %W]"/>
          </container>
        </blockdata>
      </container>
      <container n="MPspecification" pn="Material Point Specification" icon="icon_mps" state="[activate_initial_stage %W %dict %BC]" tree_state="close">
        <condition n="2D_Single-point" pn="2D Single-point" ov="surface" ovm="element" ov_element_types="triangle" icon="darkorange-shellfish-18" groups_icon="yelowish-group" help="Select your material and the surfaces related to it" state="[check_dim_points 2D:plane-strain 2D:Axissymmetric Single_point %W]" tree_state="open">
          <value n="material" pn="Material" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify" state="">
            <edit_command n="Edit materials" pn="Edit materials" icon="icon_material" proc="Anura3D::EditDatabase %W %DICT %BC"/>
          </value>
          <value n="solid_MP_number" pn="Number of material points" values="0,1,3,6,12,16,25,46,88" v="0" help="Number of material points per element" state=""/>
          <value n="material_damping" pn="Material viscous damping" editable="0" help="Damping coefficient" v="0.0" state=""/>
          <group n="2D Single-point Auto1" ov="surface" tree_state="close">
            <value n="material" pn="Material" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" state="normal" v="soil" tree_state="close"/>
            <value n="solid_MP_number" pn="Number of material points" values="0,1,3,6,12,16,25,46,88" help="Number of material points per element" state="normal" v="3" tree_state="close"/>
            <value n="material_damping" pn="Material viscous damping" editable="0" help="Damping coefficient" state="normal" v="0.0" tree_state="close"/>
          </group>
        </condition>
        <condition n="2D_Double-point" pn="2D Double-point" ov="surface" ovm="element" ov_element_types="triangle" icon="darkorange-shellfish-18" groups_icon="yelowish-group" help="Select your material and the surfaces related to it" state="[check_dim_points 2D:plane-strain 2D:Axissymmetric Double_point %W]">
          <value n="material" pn="Material" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify">
            <edit_command n="Edit materials" pn="Edit materials" icon="icon_material" proc="Anura3D::EditDatabase %W %DICT %BC"/>
          </value>
          <value n="solid_MP_number" pn="Number of solid material points" values="0,1,3,6,12,16,25,46,88" v="0" help="Number of solid material points per element"/>
          <value n="liquid_MP_number" pn="Number of liquid material points" values="0,1,3,6,12,16,25,46,88" v="0" help="Number of liquid material points per element"/>
          <value n="material_damping" pn="Material viscous damping" editable="0" help="Damping coefficient" v="0.0"/>
        </condition>
        <condition n="3D_Single-point" pn="3D Single-point" ov="volume" ovm="element" ov_element_types="tetrahedra" icon="darkorange-shellfish-18" groups_icon="yelowish-group" help="Select your material and the surfaces related to it" state="[check_dim_points 3D 3D:Axissymmetric Single_point %W]">
          <value n="material" pn="Material" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify">
            <edit_command n="Edit materials" pn="Edit materials" icon="icon_material" proc="Anura3D::EditDatabase %W %DICT %BC"/>
          </value>
          <value n="solid_MP_number" pn="Number of material points" values="0,1,4,7,8,10,13,20" v="0" help="Number of material points per element"/>
          <value n="material_damping" pn="Material viscous damping" editable="0" help="Damping coefficient" v="0.0"/>
        </condition>
        <condition n="3D_Double-point" pn="3D Double-point" ov="volume" ovm="element" ov_element_types="tetrahedra" icon="darkorange-shellfish-18" groups_icon="yelowish-group" help="Select your material and the surfaces related to it" state="[check_dim_points 3D 3D:Axissymmetric Double_point %W]">
          <value n="material" pn="Material" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify">
            <edit_command n="Edit materials" pn="Edit materials" icon="icon_material" proc="Anura3D::EditDatabase %W %DICT %BC"/>
          </value>
          <value n="solid_MP_number" pn="Number of solid material points" values="0,1,4,7,8,10,13,20" v="0" help="Number of solid material points per element"/>
          <value n="liquid_MP_number" pn="Number of liquid material points" values="0,1,4,7,8,10,13,20" v="0" help="Number of liquid material points per element"/>
          <value n="material_damping" pn="Material viscous damping" editable="0" help="Damping coefficient" v="0.0"/>
        </condition>
      </container>
      <container n="Initial_cond" pn="Initial conditions" icon="" help="Specify initial conditions for the problem." state="[activate_initial_stage %W %dict %BC]" tree_state="close">
        <condition n="Initial_MP_velocity" pn="Initial Velocity (on material points)" icon="icon_initial" ov="[check_dim_surface_volume 2D:plane-strain 2D:Axissymmetric %W]" ovm="element" help="Use this condition to apply an initial velocity on material points" actualize_tree="1">
          <value n="X_direction" pn="x direction [m/s]" v="0.0"/>
          <value n="Y_direction" pn="y direction [m/s]" v="0.0"/>
          <value n="Z_direction" pn="z direction [m/s]" v="0.0" state="[check_dim 3D 3D:Axissymmetric %W]" actualize_tree="1"/>
        </condition>
        <container n="Stress_initialization" pn="Stress Initialization" icon="">
          <value n="Apply_K0" pn="K0-PROCEDURE" icon="icon_K0" values="do not apply,apply" v="do not apply">
            <dependencies node="../container[@n='Not-horizontal']" att1="state" v1="normal" value="apply"/>
            <dependencies node="../container[@n='Not-horizontal']" att1="state" v1="hidden" value="do not apply"/>
            <dependencies node="../container[@n='Horizontal']" att1="state" v1="normal" value="apply"/>
            <dependencies node="../container[@n='Horizontal']" att1="state" v1="hidden" value="do not apply"/>
            <dependencies node="../value[@n='initial_vertical_load']" att1="state" v1="normal" value="apply"/>
            <dependencies node="../value[@n='initial_vertical_load']" att1="state" v1="hidden" value="do not apply"/>
            <dependencies node="../value[@n='INITIAL_WATER_PRESSURE']" att1="state" v1="normal" value="apply"/>
            <dependencies node="../value[@n='INITIAL_WATER_PRESSURE']" att1="state" v1="hidden" value="do not apply"/>
          </value>
          <container n="Not-horizontal" pn="General condition (not-horizontal surface)" icon="" state="hidden">
            <condition n="Soil_surface" pn="Soil Surface" ov="line" ovm="face_element" icon="icon_soil_surface" help="Select lines of geometry to assign the initial soil surface" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]"/>
            <container n="Phreatic_surface" pn="Phreatic Surface" icon="icon_phreatic">
              <condition n="Phreatic_surface_line" pn="Select water table profile" icon="icon_phreatic" ov="line" ovm="face_element" help="Select lines of geometry to define the initial phreatic surface" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]"/>
              <blockdata n="Phreatic_surface" name="Add water table 1" sequence="1" editable_name="unique" morebutton="0" icon="icon_phreatic">
                <edit_command n="water_table" pn="Add water table" proc="WaterTable::create_table %W" edit_type="exclusive"/>
                <value n="Number_of_materials" pn="Number of materials" icon="icon_phreatic" values="please specify,1,2,3,4,5" v="please specify">
                  <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="hidden" value="please specify"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="1"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="2"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="3"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="4"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="5"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="hidden" value="please specify"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="hidden" value="1"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="2"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="3"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="4"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="5"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="hidden" value="please specify"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="hidden" value="1"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="hidden" value="2"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="normal" value="3"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="normal" value="4"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="normal" value="5"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="please specify"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="1"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="2"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="3"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="normal" value="4"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="normal" value="5"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="please specify"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="1"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="2"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="3"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="4"/>
                  <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="normal" value="5"/>
                </value>
                <value n="material_phreatic_surface_file1" pn="Material 1" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
                  <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="Anura3D::EditDatabase %W %DICT %BC"/>
                </value>
                <value n="material_phreatic_surface_file2" pn="Material 2" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
                  <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="Anura3D::EditDatabase %W %DICT %BC"/>
                </value>
                <value n="material_phreatic_surface_file3" pn="Material 3" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
                  <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="Anura3D::EditDatabase %W %DICT %BC"/>
                </value>
                <value n="material_phreatic_surface_file4" pn="Material 4" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
                  <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="Anura3D::EditDatabase %W %DICT %BC"/>
                </value>
                <value n="material_phreatic_surface_file5" pn="Material 5" editable="0" help="Choose a material from the database" values="[Anura3D::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
                  <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="Anura3D::EditDatabase %W %DICT %BC"/>
                </value>
              </blockdata>
            </container>
            <value n="MAX_SUCTION_AT_SOIL_SURFACE" pn="Max suction at soil surface [kPa]" values="do not specify,specify" v="do not specify" state="normal" actualize_tree="1">
              <dependencies node="../value[@n='suction']" att1="state" v1="normal" value="specify"/>
